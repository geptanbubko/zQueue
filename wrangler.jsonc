{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zqueue",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "queue-db",
      "database_id": "88b648a5-57ae-4d54-807d-af179894e5e5",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "BLACKJACK_LOGIN_LIMIT", "namespace_id": "41001", "simple": { "limit": 12, "period": 60 } },
    { "name": "BLACKJACK_CHAT_LIMIT", "namespace_id": "41002", "simple": { "limit": 8, "period": 10 } }
  ],
  "observability": { "enabled": true }
}
